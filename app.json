{
  "expo": {
    "name": "SETLOG",
    "slug": "setlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F5F4F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.setlog.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F4F1"
      },
      "package": "com.setlog.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single-page"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
