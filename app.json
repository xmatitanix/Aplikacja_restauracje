{
  "expo": {
    "name": "SETLOG",
    "slug": "setlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F5F4F1",
      "resizeMode": "contain",
      "image": "./assets/splash.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.setlog.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.setlog.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F4F1"
      },
      "permissions": [],
      "minSdkVersion": 24,
      "targetSdkVersion": 35
    },
    "web": {
      "bundler": "metro",
      "output": "single-page",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "setlog-dj-rating"
      }
    }
  }
}
